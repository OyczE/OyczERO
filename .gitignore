# Only distribution categories may enter the future publishing repository.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/CHANGELOG.md
!/LICENSE.md
!/THIRD-PARTY-NOTICES.md
!/releases/
!/packages/
!/docs/
!/flasher/

# Binary release payloads are staged locally and uploaded as Release assets.
*.img
*.img.xz
*.img.gz
*.swu
*.exe
*.msi
*.app/
*.dmg
*.pkg
*.AppImage
*.deb
*.rpm
*.bin
*.elf
*.dll
*.so
*.so.*
*.dylib
*.pdb
*.zip
*.tar
*.tar.gz
*.tar.xz
*.tar.zst
*.age

# Development dependencies, private state and credentials are not exports.
**/node_modules/
**/target/
**/__pycache__/
**/.cache/
**/.git/
**/output/
**/backups/
**/.env
**/.env.*
*.key
*.pem
*.p12
*.pfx
*.log
*.map
id_rsa
id_ed25519
oyczero_ed25519

# Desktop metadata.
.DS_Store
Thumbs.db
